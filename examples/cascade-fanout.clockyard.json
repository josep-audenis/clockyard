  "metadata": {
    "name": "Cascade with fan-out",
    "createdAt": "2026-11-06T12:00:00.000Z",
    "modifiedAt": "2026-11-06T12:00:00.000Z",
    "notes": "Gates in two levels, with one output driving several inputs (fan-out). Switch 1 (call it A) feeds the XOR gate, the AND gate and the left LED; the XOR of A and Switch 2 (B) feeds the AND gate too.\n\nSo the right LED lights when A AND (A XOR B) is 1, which is when A is on and B is off. Try all four combinations of the two switches.\n\nEvery change settles through both levels at once: the LEDs never show a value halfway through."
  },
  "circuit": {
    "components": [
      { "id": "a", "kind": "switch", "position": { "x": 0, "y": 0 }, "rotation": 0, "props": {} },
      { "id": "b", "kind": "switch", "position": { "x": 0, "y": 6 }, "rotation": 0, "props": {} },
      { "id": "x", "kind": "xor", "position": { "x": 5, "y": 1 }, "rotation": 0, "props": {} },
      { "id": "y", "kind": "and", "position": { "x": 12, "y": 3 }, "rotation": 0, "props": {} },
      { "id": "led-a", "kind": "led", "position": { "x": 12, "y": 10 }, "rotation": 0, "props": {} },
      { "id": "led-y", "kind": "led", "position": { "x": 19, "y": 4 }, "rotation": 0, "props": {} }
    ],
    "junctions": [],
    "wires": [
      { "id": "w-a-x", "from": { "component": "a", "port": "out" }, "to": { "component": "x", "port": "a" } },
      { "id": "w-b-x", "from": { "component": "b", "port": "out" }, "to": { "component": "x", "port": "b" } },
      { "id": "w-x-y", "from": { "component": "x", "port": "out" }, "to": { "component": "y", "port": "a" } },
      { "id": "w-a-y", "from": { "component": "a", "port": "out" }, "to": { "component": "y", "port": "b" } },
      { "id": "w-a-led", "from": { "component": "a", "port": "out" }, "to": { "component": "led-a", "port": "in" } },
      { "id": "w-y-led", "from": { "component": "y", "port": "out" }, "to": { "component": "led-y", "port": "in" } }
    ]
  },
