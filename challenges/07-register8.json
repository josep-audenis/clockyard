    {"set":{"load":1},"expect":{"Q":255}},
    {"set":{"clk":1},"expect":{"Q":0}},
    {"set":{"clk":0},"expect":{"Q":0}},
    {"set":{"D":90,"load":0},"expect":{"Q":0}},
    {"set":{"clk":1},"expect":{"Q":0}},
