      "name": "D",
      "width": 8
    },
    {
      "name": "load",
      "width": 1
    },
    {
      "name": "clk",
      "width": 1
    }
  ],
  "outputs": [
    {
      "name": "Q",
      "width": 8
    }
  ],
  "parts": [
    "not",
    "and",
    "nand",
    "or",
    "nor",
    "xor",
    "xnor",
    "dff",
    "split",
    "merge"
  ],
  "steps": [
