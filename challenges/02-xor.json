{
  "title": "XOR from NAND gates",
  "text": "Build XOR from NAND gates alone: Y is 1 when exactly one of A and B is 1.",
  "definition": "xor",
  "inputs": [
    {
      "name": "A",
      "width": 1
    },
    {
      "name": "B",
      "width": 1
    }
  ],
  "outputs": [
    {
      "name": "Y",
      "width": 1
    }
  ],
  "parts": [
    "nand"
  ],
  "steps": [
    {
      "set": {
        "A": 0,
        "B": 0
      },
      "expect": {
        "Y": 0
      }
    },
    {
      "set": {
        "A": 0,
        "B": 1
      },
      "expect": {
        "Y": 1
      }
    },
    {
      "set": {
        "A": 1,
        "B": 0
      },
      "expect": {
        "Y": 1
      }
    },
    {
      "set": {
        "A": 1,
        "B": 1
      },
      "expect": {
        "Y": 0
      }
    }
  ]
}
