    {
      "name": "clk",
      "width": 1
    },
    {
      "name": "push",
      "width": 1
    },
    {
      "name": "pop",
      "width": 1
    },
    {
      "name": "din",
      "width": 8
    }
  ],
  "outputs": [
    {
      "name": "top",
      "width": 8
    },
    {
      "name": "sp",
      "width": 4
    }
  ],
